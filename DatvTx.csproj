<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DatvTx</AssemblyName>
    <RootNamespace>DatvTx</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.2.2</Version>
    <InformationalVersion>1.2.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>DATV TX (M0CKE)</Product>
    <Company>M0CKE</Company>
    <Description>DATV transmitter control for Pluto (F5OEO), LimeSDR Mini and HackRF</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DatvTx.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DatvTx.ico" LogicalName="DatvTx.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.3.952" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linux version (Avalonia) and tools are built separately -->
    <Compile Remove="linux\**" />
    <Compile Remove="tools\**" />
    <None Remove="linux\**" />
  </ItemGroup>
</Project>
