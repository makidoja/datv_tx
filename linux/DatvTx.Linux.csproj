<Project Sdk="Microsoft.NET.Sdk">
  <!-- DATV TX for Linux: Avalonia UI on top of the same Core/ and Hardware/ code as the Windows app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>datvtx</AssemblyName>
    <RootNamespace>DatvTx.LinuxUi</RootNamespace>
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../Hardware/**/*.cs" LinkBase="Hardware" />
    <EmbeddedResource Include="../Assets/DatvTx.ico" LogicalName="DatvTx.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="MQTTnet" Version="4.3.3.952" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
